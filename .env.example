# --- Database: Supabase ---
# Supabase → Connect → "Session pooler" хаяг (Direct нь IPv6-only, Transaction pooler :6543 нь
# psycopg3/Alembic-тай зөрчилддөг). Нууц үгэнд @ : / # % байвал URL-encode хий (@ → %40).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Database: локал PostgreSQL (docker compose --profile localdb up) ---
POSTGRES_USER=mathapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mathapp
# DATABASE_URL=postgresql+psycopg://mathapp:change_me@db:5432/mathapp

# --- Object storage (MinIO = локал S3) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=uploads
S3_REGION=us-east-1
# Supabase Storage руу шилжих бол (Storage → Settings → S3 Connection, bucket "uploads"-ийг private үүсгэ):
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_ACCESS_KEY=<access key id>
# S3_SECRET_KEY=<secret access key>
# S3_REGION=<төслийн region, ж: ap-southeast-1>

# --- ML сервис (ml/service.py). Хоосон бол ML-гүй горим: OCR/ангилал ажиллахгүй, гараар бичнэ ---
ML_SERVICE_URL=http://ml:8001

# --- Auth ---
JWT_SECRET=change_me_to_long_random_string
JWT_EXPIRE_MINUTES=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
